<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<!--
  launchd service definition for jackhpark-pm-intelligence-engine.

  SETUP (one-time on iMac):
    make install-service

  This registers the service in ~/Library/LaunchAgents/ so that:
    - pm-engine starts automatically on login
    - launchd restarts the process if it crashes (KeepAlive = true)

  BEFORE INSTALLING — verify these paths match your iMac:
    WorkingDirectory     : absolute path to this repository
    ProgramArguments[0]  : absolute path to uvicorn binary
                           Run `which uvicorn` in your shell to find it.
                           Default below assumes anaconda at /opt/anaconda3.

  MANUAL CONTROL (after install-service):
    launchctl stop  com.jackpark.pm-engine   # graceful stop (launchd will restart — use uninstall-service to remove)
    launchctl start com.jackpark.pm-engine   # start manually
    launchctl list | grep pm-engine          # check status

  LOGS:
    logs/server.log  (relative to WorkingDirectory)
-->

<plist version="1.0">
<dict>

  <key>Label</key>
  <string>com.jackpark.pm-engine</string>

  <!-- Run uvicorn directly; adjust path to match `which uvicorn` on iMac -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/anaconda3/bin/uvicorn</string>
    <string>app.api.main:app</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8000</string>
  </array>

  <!-- Must match the absolute path of this repository on the iMac -->
  <key>WorkingDirectory</key>
  <string>/Users/jackpark/workspace/code/core/jackhpark-pm-intelligence-engine</string>

  <!-- Ensure conda and system binaries are on PATH for the subprocess -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/anaconda3/bin:/opt/anaconda3/condabin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Start automatically when the user logs in -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Restart automatically on crash -->
  <key>KeepAlive</key>
  <true/>

  <!-- Both stdout and stderr go to the same log file -->
  <key>StandardOutPath</key>
  <string>/Users/jackpark/workspace/code/core/jackhpark-pm-intelligence-engine/logs/server.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/jackpark/workspace/code/core/jackhpark-pm-intelligence-engine/logs/server.log</string>

</dict>
</plist>
