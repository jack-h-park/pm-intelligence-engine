<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<!--
  launchd service definition for pm-intelligence-engine.

  SETUP (one-time on iMac):
    make install-service

  This registers the service in ~/Library/LaunchAgents/ so that:
    - pm-engine starts automatically on login
    - launchd restarts the process if it crashes (KeepAlive = true)

  PATHS — this file is configured for the hermes-runner iMac account:
    WorkingDirectory     : /Users/hermes-runner/workspace/code/core/pm-intelligence-engine
    ProgramArguments[0]  : /Users/hermes-runner/miniconda3/bin/uvicorn
    If deploying under a different user, update all three hermes-runner paths
    and run `which uvicorn` to confirm the binary location.

  MANUAL CONTROL (after install-service):
    launchctl stop  com.jackpark.pm-engine   # graceful stop (launchd will restart — use uninstall-service to remove)
    launchctl start com.jackpark.pm-engine   # start manually
    launchctl list | grep pm-engine          # check status

  LOGS:
    logs/server.log  (relative to WorkingDirectory)
-->

<plist version="1.0">
<dict>

  <key>Label</key>
  <string>com.jackpark.pm-engine</string>

  <!-- Run uvicorn directly (hermes-runner account, miniconda3) -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/hermes-runner/miniconda3/bin/uvicorn</string>
    <string>app.api.main:app</string>
    <string>--host</string>
    <string>0.0.0.0</string>
    <string>--port</string>
    <string>8000</string>
  </array>

  <!-- Must match the absolute path of this repository on the iMac -->
  <key>WorkingDirectory</key>
  <string>/Users/hermes-runner/workspace/code/core/pm-intelligence-engine</string>

  <!-- Ensure conda and system binaries are on PATH for the subprocess -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/hermes-runner/miniconda3/bin:/Users/hermes-runner/miniconda3/condabin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Start automatically when the user logs in -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Restart automatically on crash -->
  <key>KeepAlive</key>
  <true/>

  <!-- Both stdout and stderr go to the same log file -->
  <key>StandardOutPath</key>
  <string>/Users/hermes-runner/workspace/code/core/pm-intelligence-engine/logs/server.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/hermes-runner/workspace/code/core/pm-intelligence-engine/logs/server.log</string>

</dict>
</plist>
