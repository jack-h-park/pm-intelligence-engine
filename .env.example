# =============================================================================
# pm-intelligence-engine — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values before starting the API.
# The service can run locally or on a host of your choice.

# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# claude | openai
LLM_PROVIDER=openai

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-sol

# Anthropic (used when LLM_PROVIDER=claude). Billed pay-as-you-go against
# Switching providers may change billing and model behaviour.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# ----------------------------------------------------------------------------
# S2K completion bridge (isolated; unset until separately provisioned)
# ----------------------------------------------------------------------------
# Static absolute executable and script paths only, for example:
# S2K_COMPLETION_COMMAND=/absolute/path/to/python /absolute/path/to/s2k_completion.py
# Credentials are not configured here. The child receives no Engine provider keys.
S2K_COMPLETION_COMMAND=
S2K_COMPLETION_PROFILE_HOME=
S2K_COMPLETION_TIMEOUT_SECONDS=90
S2K_COMPLETION_MAX_STDOUT_BYTES=1048576

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Default: SQLite in the project root. Change to a PostgreSQL URL for v2.
DATABASE_URL=sqlite:///./pm_platform.db

# -----------------------------------------------------------------------------
# Insight knowledge verdict budget (optional, fail closed)
# -----------------------------------------------------------------------------
# The allowance is a UTC-calendar-day total. The maximum is the cost ceiling
# reserved by one verdict call. Set both values together; omitting either
# prevents knowledge verdict calls.
INTELLIGENCE_RATE_REVISION=
INTELLIGENCE_KNOWLEDGE_ALLOWANCE_MICROS=
INTELLIGENCE_KNOWLEDGE_MAXIMUM_MICROS=
# Operator-managed rubric path. The Engine reads and hashes it; it never copies
# the rubric into this repository.
KNOWLEDGE_RUBRIC_PATH=

# -----------------------------------------------------------------------------
# API Authentication  (required)
# -----------------------------------------------------------------------------
# Shared bearer token validated server-side. Every endpoint except GET /health
# requires `Authorization: Bearer ${PM_PLATFORM_API_TOKEN}`. The same value must
# be set in the calling client's environment so it can authenticate.
# If left empty, the server fails closed: all authenticated routes return 503.
# Generate a strong value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PM_PLATFORM_API_TOKEN=

# Separate operator-only credential for fencing an ambiguous S2K operation.
# The server records this configured identity in the durable audit row.
S2K_RECONCILIATION_TOKEN=
S2K_RECONCILIATION_OPERATOR_ID=

# -----------------------------------------------------------------------------
# External Repository Paths
# -----------------------------------------------------------------------------
# Point these at operator-managed companion data. Relative paths are suitable
# for a local demo; production deployments should use an explicit path.
DECISION_CONTEXT_ROOT=./decision-context
WIKI_ROOT=./wiki

# -----------------------------------------------------------------------------
# Auto-Triage
# -----------------------------------------------------------------------------
# Runs with relevance_score strictly below this threshold are automatically
# completed as 'file' mode without pausing at Gate 1.
# Range 1-5. Default 3 means scores 1-2 are auto-triaged; score 3+ goes to PM.
AUTO_TRIAGE_THRESHOLD=3

# Transitional cutover switch for auto-triage wiki archive.
# While true, pm-engine writes the legacy local wiki archive for auto-triaged
# signals. Set to false when an external operations service owns that archive.
AUTO_TRIAGE_LOCAL_ARCHIVE_ENABLED=true

# -----------------------------------------------------------------------------
# Server Base URL  (required for mobile review page links)
# -----------------------------------------------------------------------------
# Used to construct review-page links in notifications.
# Leave as localhost for local development; use the operator's HTTPS URL in production.
BASE_URL=http://localhost:8000

# Optional. Point review links at a separate, browser-reachable review UI
# instead of this service's own /runs/{id}/review page, which sits behind the
# same bearer auth as every other route and so 401s in a browser. When set,
# links become "<REVIEW_UI_BASE_URL>/runs/<run_id>".
# REVIEW_UI_BASE_URL=https://your-console.example

# Optional. Export pipeline traces — one span per stage, one per LLM call — to
# a Langfuse project. Off unless both keys are set; the service runs identically
# without them. Requires the optional dependencies: pip install -e '.[telemetry]'
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://us.cloud.langfuse.com

# -----------------------------------------------------------------------------
# Notifications -- Gate 1, Gate 2, and Gate 3 alerts
# -----------------------------------------------------------------------------
# pm-engine sends gate notifications directly via these credentials.
# Leave a token/URL empty ("") to disable that provider.
# Both Telegram and Slack can be active simultaneously.
#
# Configure a bot token and chat ID only if Telegram delivery is desired.
#
# Gate coverage:
#   Gate 1 (awaiting_direction): fired after Stage 2
#   Gate 2 (waiting_approval):   fired after Stage 4 in decide mode
#   Gate 3 (waiting_routing_review): fired after Stage 5 routes to kill
#
# Telegram: obtain a bot token from @BotFather, then get your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack: create an Incoming Webhook in your Slack app settings.
SLACK_WEBHOOK_URL=
