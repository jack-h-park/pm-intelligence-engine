# =============================================================================
# jackhpark-pm-agentic-platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values before starting the API.
# pm-platform is designed to run on an always-on iMac.
# See docs/ARCHITECTURE.md Section 11 for the full hosting and notification setup.

# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# claude | openai
LLM_PROVIDER=claude

# Anthropic (used when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Default: SQLite in the project root. Change to a PostgreSQL URL for v2.
DATABASE_URL=sqlite:///./pm_platform.db

# -----------------------------------------------------------------------------
# External Repository Paths
# -----------------------------------------------------------------------------
# These must point to locally-cloned copies of the companion repos.
# On iMac the paths below match the standard workspace layout.
# Override here if the iMac uses a different path.
DECISION_CONTEXT_ROOT=/Users/jackpark/workspace/ai-assets/decision-context-companion-repo
WIKI_ROOT=/Users/jackpark/workspace/ai-assets/product-management-wiki-repo

# -----------------------------------------------------------------------------
# Auto-Triage
# -----------------------------------------------------------------------------
# Runs with relevance_score strictly below this threshold are automatically
# completed as 'file' mode without pausing at Gate 1.
# Range 1-5. Default 3 means scores 1-2 are auto-triaged; score 3+ goes to PM.
AUTO_TRIAGE_THRESHOLD=3

# Transitional cutover switch for auto-triage wiki archive.
# While true, pm-platform writes the legacy local wiki archive for auto-triaged
# signals. Set to false once Hermes has taken over auto-triage archive ownership.
AUTO_TRIAGE_LOCAL_ARCHIVE_ENABLED=true

# -----------------------------------------------------------------------------
# Server Base URL  (required for mobile review page links)
# -----------------------------------------------------------------------------
# Used to construct the Gate 2 review page link sent in Telegram notifications.
# In production, set this to the iMac's Tailscale IP so the link opens on iPhone:
#   BASE_URL=http://100.x.x.x:8000
# Leave as localhost for local development only.
BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Notifications -- Gate 1, Gate 2, and Gate 3 alerts
# -----------------------------------------------------------------------------
# pm-platform sends gate notifications directly via these credentials.
# Leave a token/URL empty ("") to disable that provider.
# Both Telegram and Slack can be active simultaneously.
#
# Telegram setup (iMac production):
#   - Bot token: same token as the hermes-ops Telegram bot (@JacksHermesOpsBot)
#   - Chat ID: your personal chat ID with the bot
#   - pm-platform uses sendMessage (POST only) — no conflict with hermes-ops polling
#   - After filling in tokens, restart pm-platform for the change to take effect
#
# Gate coverage:
#   Gate 1 (awaiting_direction): fired after Stage 2
#   Gate 2 (waiting_approval):   fired after Stage 4 in decide mode
#   Gate 3 (waiting_routing_review): fired after Stage 5 routes to kill
#
# Responding to gate notifications: use hermes-ops (@JacksHermesOpsBot) to
# send natural-language commands — see hermes-control-plane/docs/runbooks.md

# Telegram: obtain a bot token from @BotFather, then get your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack: create an Incoming Webhook in your Slack app settings.
SLACK_WEBHOOK_URL=
