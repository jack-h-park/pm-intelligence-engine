# LLM Provider: claude | openai
LLM_PROVIDER=claude

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Database (default: SQLite in project root)
DATABASE_URL=sqlite:///./pm_platform.db

# External repository paths (defaults match the standard workspace layout)
DECISION_SYSTEM_ROOT=/Users/jackpark/workspace/ai-assets/jackhpark-pm-decision-system
WIKI_ROOT=/Users/jackpark/workspace/ai-assets/jackhpark-product-management-wiki
